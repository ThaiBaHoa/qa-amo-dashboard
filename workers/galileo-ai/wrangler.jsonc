{
  // galileo-ai — deploy: `npx.cmd wrangler deploy` in this folder.
  // Secret ANTHROPIC_API_KEY lives on Cloudflare only (never here); deploy does not touch it.
  "name": "galileo-ai",
  "main": "src/worker.js",
  "workers_dev": true,
  "preview_urls": false,
  "compatibility_date": "2026-05-16",
  "vars": {
    // 'soft' = check sign-in and log, still serve · 'enforce' = refuse without an admin / moderator session
    "AUTH_MODE": "soft",
    // public values, the same ones classic.html ships to every browser
    "SUPA_URL": "https://czftzgdcnpnspbbegwjt.supabase.co",
    "SUPA_KEY": "sb_publishable_eGdEXBCSD_19tu4sOV8NWQ_8mZmUqqq"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "enabled": true, "head_sampling_rate": 1, "persist": true, "invocation_logs": true }
  }
}
